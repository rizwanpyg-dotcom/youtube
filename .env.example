# Copy to .env for LOCAL runs only (.env is git-ignored). In the cloud these are GitHub Actions Secrets.
# Never paste these values into chat, issues, logs or the dashboard.

# Google AI Studio key, created WITHOUT a billing account (free tier only)
GEMINI_API_KEY=

# Optional fallback LLM: a GitHub token with the models:read permission
GITHUB_TOKEN=

# YouTube OAuth (from scripts/oauth_bootstrap.py, Phase 5)
YT_CLIENT_ID=
YT_CLIENT_SECRET=
YT_REFRESH_TOKEN=

# LLM selection: auto | gemini | github_models | fixture:<set>
YT_LLM=auto
